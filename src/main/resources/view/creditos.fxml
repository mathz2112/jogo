        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label style="-fx-text-fill: #00e5ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="Jogo:" />
        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" text="Beyond the Walls: O Desaparecimento de Pintas" />

        <Label style="-fx-text-fill: #00e5ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="Feito por:" />
        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" text="Emanuelle Candido e Matheus Muniz " />

        <Label style="-fx-text-fill: #00e5ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="Disciplina:" />
