<VBox alignment="CENTER" prefHeight="640.0" prefWidth="960.0" spacing="20.0" style="-fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-background-color: #1e1e1e; -fx-padding: 30; -fx-alignment: center;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CreditosController">

