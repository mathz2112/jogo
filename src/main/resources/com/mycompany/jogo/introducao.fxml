<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.IntroducaoController">
    <children>
        <Label fx:id="introducao"
       layoutX="50"
       layoutY="500"
       prefWidth="700"
       prefHeight="100"/>
        
        <Button fx:id="paraEntrada"
        layoutX="50"
        layoutY="620"
        alignment="CENTER_RIGHT" 
        text="Continuar"
        onAction="#irEntrada"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
