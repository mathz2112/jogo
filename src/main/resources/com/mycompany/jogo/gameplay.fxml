<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.GameplayController">
    

     <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0"/>
    </padding>

    <children>

        <Label fx:id="nomeLabel"
               text="Narrador"/>

        <Label fx:id="dialogoLabel"
               text="Texto do diálogo"/>

        <Button fx:id="botao1"
                text="Escolha 1"
                onAction="#escolha1"/>

        <Button fx:id="botao2"
                text="Escolha 2"
                onAction="#escolha2"/>

    </children>
    
</VBox>
